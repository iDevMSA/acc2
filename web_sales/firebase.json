{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.txt", "*.txt"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
